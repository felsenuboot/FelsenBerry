  "note": "Machine-readable no-dig registry. Source of truth for digguard.js (bot.dig guard) and, once P0.3 lands, for pathfinder Movements exclusionAreasBreak/Place. Human source of truth stays BASE.md section 1 \u2014 when you add/change a row there, mirror it here. digguard hot-reloads this file (mtime poll, ~10s), so edits reach running bots without re-injection.",
  "schema": {
    "region.kind": "box | columns | sphere",
    "box": "min [x,y,z] and max [x,y,z], both INCLUSIVE",
    "columns": "list of [x,z] pairs plus yMin/yMax (inclusive) \u2014 for pillar/post structures",
    "sphere": "center [x,y,z] + radius (block distance, 3D)",
    "match": "optional regex (string, case-insensitive) on block.name \u2014 only blocks matching are protected. Absent = every non-air block in the region.",
    "exclude": "optional list of boxes carved OUT of the region (intentional gaps: shafts, doorways)",
    "reason": "shown in the refusal chat line / log"
  },
